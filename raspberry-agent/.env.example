# Loveskin NovaStar Agent — env vars
# Copy to .env and fill in values.

SUPABASE_URL=https://tydgfavxnxdyrxxehxkt.supabase.co

# Service role key (DO NOT commit). Get from Supabase dashboard → Settings → API.
SUPABASE_SERVICE_KEY=

# The display this Raspberry is bound to (matches displays.id in the DB).
DISPLAY_ID=disp_XXXXXXXX

# IP of the TB50 on the local LAN. Leave empty to auto-discover via findNetDevices().
TB50_IP=192.168.1.40
